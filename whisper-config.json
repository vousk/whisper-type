{
    "ui": {
        "calm_mode": true,
        "rec_overlay": false
    },
    "hotkeys": {
        "dictation": "ctrl+²"
    },
    "audio": {
        "sample_rate": 16000,
        "beep_volume": 0.1,
        "silence_timeout_seconds": 20
    },
    "model": {
        "size": "large-v3-turbo",
        "device": "cuda",
        "compute_type": "int8_float16"
    },
    "transcription": {
        "dictation_language": "fr",
        "beam_size": 3,
        "vad_filter": true,
        "condition_on_previous_text": false,
        "initial_prompt": "Cette dictée est en français. Les termes utilisés peuvent être PongFlow, Ping, FFTT, SPIDD v2, Vousk-prod., Vousk.",
        "no_speech_threshold": null,
        "debug_transcription": false,
        "short_text_max_words": 3
    },
    "post_processing": {
        "apply_spoken_punctuation": false,
        "spoken_punctuation": {
            "[,\\s]*[-–]?\\s*Doppelpunkt[,\\s]*": ": ",
            "[,\\s]*[-–]?\\s*Semikolon[,\\s]*": "; ",
            "[,\\s]*[-–]?\\s*Ausrufezeichen": "!",
            "[,\\s]*[-–]?\\s*Fragezeichen": "?",
            "[,\\s]*[-–]?\\s*Gedankenstrich[,\\s]*": " - ",
            "[,\\s]*[-–]?\\s*(?:Schrägstrich|Slash)[,\\s]*": "/",
            "[,\\s]*[-–]?\\s*Anführungszeichen[,\\s]*": "\"",
            "[,\\s]*[-–]?\\s*Punkt": "."
        },
        "word_corrections": {
            "\\b(?:W|V)(?:u|o|oo|ou|uo)s(?:k|c)\\b": "Vousk",
            "\\bvouskprod\\b": "Vousk-prod."
        },
        "hallucination_phrases": [
            "thank you for watching"
        ]
    }
}
