{
    "ui": {
        "calm_mode": false,
        "rec_overlay": false,
        "dashboard_history_entries": 8,
        "preserve_dashboard_history": false
    },
    "logging": {
        "save_history": true,
        "max_file_size_mb": 3
    },
    "hotkeys": {
        "dictation": "ctrl+²"
    },
    "audio": {
        "sample_rate": 16000,
        "beep_volume": 0.05,
        "silence_timeout_seconds": 10
    },
    "model": {
        "size": "large-v3-turbo",
        "device": "cuda",
        "compute_type": "int8_float16"
    },
    "transcription": {
        "dictation_language": "fr",
        "beam_size": 3,
        "vad_filter": true,
        "condition_on_previous_text": false,
        "initial_prompt": "Cette dictée est en français. Certains termes utilisés peuvent être Vousk-prod., Vousk, PongFlow, Ping, FFTT, SPIDD v2, Girpe-v2, BMad, JA",
        "no_speech_threshold": null,
        "debug_transcription": false,
        "short_text_max_words": 3
    },
    "post_processing": {
        "apply_spoken_punctuation": false,
        "spoken_punctuation": {
            "[,\\s]*[-–]?\\s*Doppelpunkt[,\\s]*": ": ",
            "[,\\s]*[-–]?\\s*Semikolon[,\\s]*": "; ",
            "[,\\s]*[-–]?\\s*Ausrufezeichen": "!",
            "[,\\s]*[-–]?\\s*Fragezeichen": "?",
            "[,\\s]*[-–]?\\s*Gedankenstrich[,\\s]*": " - ",
            "[,\\s]*[-–]?\\s*(?:Schrägstrich|Slash)[,\\s]*": "/",
            "[,\\s]*[-–]?\\s*Anführungszeichen[,\\s]*": "\"",
            "[,\\s]*[-–]?\\s*Punkt": "."
        },
        "word_corrections": {
            "\\b(?:W|V)(?:u|o|oo|ou|uo)s(?:k|c)\\b": "Vousk",
            "\\bvouskprod\\b": "Vousk-prod.",
            "\\bJIA\\b": "JA",
            "\\bSPID\\b": "SPIDD"
        },
        "hallucination_phrases": []
    }
}
